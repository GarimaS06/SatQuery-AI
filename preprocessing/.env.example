# ============================================
# SatQuery AI — Preprocessing Service Config
# ============================================
# Copy this file to .env and adjust values as needed:
#   cp .env.example .env
# ============================================

# Port this service listens on
PORT=4000

# -------------------------------------------
# Person D's Router Integration
# -------------------------------------------
# Set to "true" ONLY after Person D confirms their API contract.
# While "false", the service works standalone without calling the router.
ROUTER_ENABLED=false

# The URL of Person D's router endpoint (assumed — update when confirmed)
ROUTER_URL=http://localhost:5000/api/router/analyze

# -------------------------------------------
# Image Upload Limits
# -------------------------------------------
# Maximum file upload size in megabytes
MAX_FILE_SIZE_MB=25

# Maximum processed image dimensions (pixels)
# Images larger than this will be resized down (preserving aspect ratio).
# Images smaller than this will NOT be enlarged.
MAX_IMAGE_WIDTH=2048
MAX_IMAGE_HEIGHT=2048
